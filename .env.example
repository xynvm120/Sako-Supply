# Node 24 reads this with: node --env-file=.env server.js
PORT=3000
# Replace these before any public deployment. Never commit the real .env.
ADMIN_EMAIL=admin@sakosupply.com
ADMIN_PASSWORD=replace-with-a-strong-password
REQUEST_LOG=on
AUTO_BACKUP=on
# Optional absolute directories:
# DATA_DIR=/app/data
# BACKUP_DIR=/app/backups
