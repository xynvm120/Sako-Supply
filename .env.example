# Node 24 reads this with: node --env-file=.env server.js
PORT=3000
# Replace these before any public deployment. Never commit the real .env.
ADMIN_EMAIL=admin@sakosupply.com
ADMIN_PASSWORD=replace-with-a-strong-password
REQUEST_LOG=on
AUTO_BACKUP=on
# Optional absolute directories:
# DATA_DIR=/app/data
# BACKUP_DIR=/app/backups

# Optional account email delivery via Resend. Leave unset for admin-assisted recovery.
# Use a verified sender/domain from your own Resend account. Never commit an API key.
# EMAIL_API_KEY=re_your_private_key
# EMAIL_FROM=Sako Supply <accounts@your-verified-domain.example>
# PUBLIC_URL=https://your-deployed-site.example
# For local email-link testing only: PUBLIC_URL=http://localhost:3000
# Optional real support address shown on Contact & Help (not the login email by default):
# SUPPORT_EMAIL=your-real-support@example.com
